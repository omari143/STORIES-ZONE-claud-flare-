{
  "rewrites": [
    {
      "source": "/story/:slug",
      "has": [
        { "type": "header", "key": "User-Agent", "value": ".*(facebookexternalhit|WhatsApp|Twitterbot|TelegramBot|LinkedInBot|Discordbot|Slackbot).*" }
      ],
      "destination": "/api/story-preview?slug=:slug"
    },
    {
      "source": "/story/:slug",
      "destination": "/story.html?slug=:slug"
    },
    {
      "source": "/audio/:slug",
      "has": [
        { "type": "header", "key": "User-Agent", "value": ".*(facebookexternalhit|WhatsApp|Twitterbot|TelegramBot|LinkedInBot|Discordbot|Slackbot).*" }
      ],
      "destination": "/api/audio-preview?slug=:slug"
    },
    {
      "source": "/audio/:slug",
      "destination": "/simulizi_audio.html?slug=:slug"
    },
    {
      "source": "/video/:slug",
      "has": [
        { "type": "header", "key": "User-Agent", "value": ".*(facebookexternalhit|WhatsApp|Twitterbot|TelegramBot|LinkedInBot|Discordbot|Slackbot).*" }
      ],
      "destination": "/api/video-preview?slug=:slug"
    },
    {
      "source": "/video/:slug",
      "destination": "/video.html?slug=:slug"
    }
  ]
}
